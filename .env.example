# =============================================================================
# DISTRIBUIDORA DE CIMENTO - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local na RAIZ do projeto.
# NUNCA commitar valores reais de chaves secretas!
#
# Após criar/editar .env.local, reinicie o dev server: pnpm dev
# Para produção (Vercel): adicione as mesmas variáveis em Settings → Environment Variables,
# marque "Production", salve e faça Redeploy.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (OBRIGATÓRIO - tanto para cliente quanto servidor)
# -----------------------------------------------------------------------------
# Público (browser + servidor) - obtenha em Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Somente servidor (NUNCA expor no browser!) - Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# AUTH & ADMIN
# -----------------------------------------------------------------------------
# Permitir cadastro de admin via POST /api/auth/register (valor exato: true)
# DESABILITADO por padrão em produção por segurança
ADMIN_REGISTRATION_OPEN=false

# -----------------------------------------------------------------------------
# GOOGLE ADS (OBRIGATÓRIO PARA TRACKING DE CONVERSÃO)
# -----------------------------------------------------------------------------
# ID de conversão do Google Ads para cliques no WhatsApp
# Crie em: Google Ads > Ferramentas > Conversões
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_ID=AW-XXXXXXXXXX/XXXXXXXXXX

# ID de conversão do Google Ads para formulário de lead
NEXT_PUBLIC_GOOGLE_ADS_LEAD_FORM_ID=AW-XXXXXXXXXX/XXXXXXXXXX

# ID de conversão do Google Ads para compra
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_ID=AW-XXXXXXXXXX/XXXXXXXXXX

# ID de conversão do Google Ads para add to cart
NEXT_PUBLIC_GOOGLE_ADS_ADD_TO_CART_ID=AW-XXXXXXXXXX/XXXXXXXXXX

# Conversions API (CAPI) — para rastreamento servidor-a-servidor
# Mais preciso que o pixel tracking, funciona com bloqueadores de ads
GOOGLE_ADS_CAPI_API_KEY=sua_api_key_capi_aqui
GOOGLE_ADS_CAPI_ACCOUNT_ID=seu_account_id_capi_aqui
GOOGLE_ADS_CAPI_ACTION=sua_conversion_action_aqui

# Google Ads Customer ID (formato: XXX-XXX-XXXX)
NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_ID=XXX-XXX-XXXX

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# NEXT.JS CONFIGURAÇÕES
# -----------------------------------------------------------------------------
# Ambiente
NODE_ENV=development

# URL do site (para redirecionamentos e links absolutos)
NEXT_PUBLIC_SITE_URL=https://distribuidora-cimento-flavioramos6711-3618s-projects.vercel.app

# -----------------------------------------------------------------------------
# SEGURANÇA (recomendado em produção)
# -----------------------------------------------------------------------------
# Secret para assinar cookies de sessão (use um valor longo e aleatório)
# NEXT_AUTH_SECRET=sua-string-secreta-longa-aqui

# -----------------------------------------------------------------------------
# PERFORMANCE
# -----------------------------------------------------------------------------
# Cache TTL para API responses (em segundos)
# API_CACHE_TTL=3600
